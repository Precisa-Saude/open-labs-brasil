{
  "name": "open-labs-brasil-ferramentas",
  "private": true,
  "version": "0.2.2",
  "description": "Servidor de exemplo, suíte de conformidade e ambiente local de teste do Open Labs Brasil",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ambiente:gerar": "node ambiente-local/gerar.ts --se-faltar",
    "servidor": "node servidor-de-exemplo/principal.ts --config ambiente-local/gerado/servidor.config.json",
    "suite": "node suite-de-conformidade/principal.ts",
    "conformidade:local": "node suite-de-conformidade/local.ts",
    "jornada": "node suite-de-conformidade/receptor-minimo/jornada.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "docs:links": "node ferramentas/conferir-links.ts",
    "verificar": "pnpm typecheck && pnpm test && pnpm conformidade:local && pnpm docs:links"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.0"
}
