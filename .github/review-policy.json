{
  "enabled": true,
  "provider": "openrouter",
  "fallbackProviders": ["anthropic"],
  "includePaths": [
    "comum/**",
    "servidor-de-exemplo/**",
    "suite-de-conformidade/**",
    "ambiente-local/**",
    "ferramentas/**",
    "especificacao/**",
    ".github/**",
    "docs/**",
    "README.md"
  ],
  "excludePaths": ["**/fixtures/**", "ambiente-local/gerado/**"],
  "scanForSecretsBeforeSending": true,
  "onSensitiveContent": "block"
}
