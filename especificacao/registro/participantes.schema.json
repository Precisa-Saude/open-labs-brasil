{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-labs-brasil.example/schemas/registro/0.1/participantes.schema.json",
  "title": "Registro de participantes do Open Labs Brasil",
  "description": "Formato do arquivo participantes.json descrito em especificacao/08-registro-de-participantes.md. Os nomes de campo são identificadores do protocolo e ficam em inglês. O host do $id (open-labs-brasil.example) é provisório: o protocolo ainda não tem domínio, e o TLD .example é reservado e não resolve.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "sequence",
    "issued_at",
    "expires_at",
    "registry_keys",
    "participants"
  ],
  "properties": {
    "schema_version": {
      "description": "Versão do formato do registro (MAJOR.MINOR). Numeração própria, independente da versão do protocolo.",
      "type": "string",
      "pattern": "^0\\.[0-9]+$"
    },
    "environment": {
      "description": "Ambiente a que o registro se aplica.",
      "enum": ["pilot", "production"]
    },
    "sequence": {
      "description": "Número de sequência do documento. Cresce em 1 a cada publicação e nunca é reutilizado.",
      "type": "integer",
      "minimum": 1
    },
    "issued_at": { "$ref": "#/$defs/utcDateTime" },
    "expires_at": { "$ref": "#/$defs/utcDateTime" },
    "registry_keys": {
      "description": "Chaves públicas aceitas para verificar a assinatura do PRÓXIMO documento do registro (sequence + 1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/registryKey" }
        }
      }
    },
    "participants": {
      "type": "array",
      "items": { "$ref": "#/$defs/participant" }
    }
  },
  "$defs": {
    "utcDateTime": {
      "description": "Data e hora RFC 3339 em UTC, com sufixo Z e sem fração de segundo.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s#]+$",
      "maxLength": 2048
    },
    "email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "maxLength": 254
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "scope": {
      "enum": [
        "catalog.read",
        "locations.read",
        "schedule.read",
        "appointment.write",
        "results.read",
        "consent.read",
        "consent.manage"
      ]
    },
    "registryKey": {
      "description": "Chave pública RSA em formato JWK (RFC 7517). O kid é o thumbprint SHA-256 da chave (RFC 7638).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "kid", "use", "alg", "n", "e"],
      "properties": {
        "kty": { "const": "RSA" },
        "kid": { "type": "string", "$ref": "#/$defs/base64url", "minLength": 43, "maxLength": 43 },
        "use": { "const": "sig" },
        "alg": { "const": "PS256" },
        "n": { "type": "string", "$ref": "#/$defs/base64url", "minLength": 342 },
        "e": { "$ref": "#/$defs/base64url" }
      }
    },
    "transportCertificate": {
      "description": "Certificado de cliente TLS que o receptor apresenta nas conexões mTLS.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x5t#S256", "x5c", "not_before", "not_after"],
      "properties": {
        "x5t#S256": {
          "description": "SHA-256 do certificado em DER, em base64url (mesmo cálculo do RFC 8705, seção 3.1).",
          "type": "string",
          "$ref": "#/$defs/base64url",
          "minLength": 43,
          "maxLength": 43
        },
        "x5c": {
          "description": "Cadeia do certificado em base64 padrão do DER, certificado folha primeiro (RFC 7517, seção 4.7).",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
        },
        "not_before": { "$ref": "#/$defs/utcDateTime" },
        "not_after": { "$ref": "#/$defs/utcDateTime" }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "role",
        "status",
        "legal_name",
        "display_name",
        "cnpj",
        "contacts",
        "protocol_versions",
        "updated_at"
      ],
      "properties": {
        "participant_id": { "$ref": "#/$defs/uuid" },
        "role": { "enum": ["provider", "receiver"] },
        "status": { "enum": ["active", "suspended", "withdrawn"] },
        "legal_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "cnpj": {
          "description": "CNPJ sem pontuação.",
          "type": "string",
          "pattern": "^[0-9A-Z]{12}[0-9]{2}$"
        },
        "contacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["technical_email", "security_email"],
          "properties": {
            "technical_email": { "$ref": "#/$defs/email" },
            "security_email": { "$ref": "#/$defs/email" }
          }
        },
        "protocol_versions": {
          "description": "Versões MAJOR.MINOR do protocolo que o participante implementa. Enquanto MAJOR for 0, exatamente uma.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
        },
        "updated_at": { "$ref": "#/$defs/utcDateTime" },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "fhir_base_url",
            "api_base_url",
            "scopes_supported",
            "consent_management_uri"
          ],
          "properties": {
            "issuer": { "$ref": "#/$defs/httpsUrl" },
            "fhir_base_url": { "$ref": "#/$defs/httpsUrl" },
            "api_base_url": { "$ref": "#/$defs/httpsUrl" },
            "scopes_supported": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/scope" }
            },
            "consent_management_uri": { "$ref": "#/$defs/httpsUrl" },
            "logo_uri": { "$ref": "#/$defs/httpsUrl" }
          }
        },
        "receiver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "client_id",
            "client_name",
            "redirect_uris",
            "jwks_uri",
            "scopes_allowed",
            "transport_certificates",
            "policy_uri",
            "tos_uri",
            "eligibility"
          ],
          "properties": {
            "client_id": { "$ref": "#/$defs/uuid" },
            "client_name": { "type": "string", "minLength": 1, "maxLength": 80 },
            "redirect_uris": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/httpsUrl" }
            },
            "jwks_uri": { "$ref": "#/$defs/httpsUrl" },
            "scopes_allowed": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/scope" }
            },
            "transport_certificates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/transportCertificate" }
            },
            "policy_uri": { "$ref": "#/$defs/httpsUrl" },
            "tos_uri": { "$ref": "#/$defs/httpsUrl" },
            "logo_uri": { "$ref": "#/$defs/httpsUrl" },
            "eligibility": {
              "description": "Declaração de elegibilidade do receptor, conferida pelo mantenedor do registro na admissão.",
              "type": "object",
              "additionalProperties": false,
              "required": ["patient_facing", "health_plan_operator", "declared_at"],
              "properties": {
                "patient_facing": { "const": true },
                "health_plan_operator": { "const": false },
                "declared_at": { "$ref": "#/$defs/date" }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "provider" } }, "required": ["role"] },
          "then": { "required": ["provider"], "not": { "required": ["receiver"] } }
        },
        {
          "if": { "properties": { "role": { "const": "receiver" } }, "required": ["role"] },
          "then": { "required": ["receiver"], "not": { "required": ["provider"] } }
        }
      ]
    }
  }
}
